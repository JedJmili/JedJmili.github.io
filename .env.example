# ============================================================
# SITE CONFIGURATION
# Copy this file to .env.local and set your values.
# Everything below is safe to commit except the actual .env.local
# ============================================================

# Your production domain (no trailing slash, no protocol).
# Example: NEXT_PUBLIC_SITE_URL=https://jedjmili.com
NEXT_PUBLIC_SITE_URL=https://jedjmili.com

# ============================================================
# AVAILABILITY STATUS — easy to change later
# Options: "open" | "limited" | "unavailable"
# ============================================================
NEXT_PUBLIC_AVAILABILITY_STATUS=open
